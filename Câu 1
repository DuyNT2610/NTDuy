#include <iostream>
#include <cmath>
using namespace std;

class PhuongTrinhBac2 {
private:
    double a, b, c;

public:
    void nhap() {
        cin >> a >> b >> c;
    }

    void giai() {
        if (a == 0) {
            if (b == 0) {
                if (c == 0)
                    cout << "Phuong trinh vo so nghiem";
                else
                    cout << "Phuong trinh vo nghiem";
            } else {
                cout << "x = " << -c / b;
            }
        } else {
            double delta = b * b - 4 * a * c;

            if (delta < 0) {
                cout << "Phuong trinh vo nghiem";
            } else if (delta == 0) {
                cout << "x = " << -b / (2 * a);
            } else {
                cout << "x1 = " << (-b + sqrt(delta)) / (2 * a) << endl;
                cout << "x2 = " << (-b - sqrt(delta)) / (2 * a);
            }
        }
    }
};

int main() {
    PhuongTrinhBac2 p;
    p.nhap();
    p.giai();
    return 0;
}
